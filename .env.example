# Шаблон настроек Ending. install.bat сам копирует его в .env.
# Файл .env хранит ваши ключи: никому его не отправляйте и не публикуйте.
# Подробности: README.md, раздел «Подключение Twitch».

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=
TWITCH_REDIRECT_URI=http://localhost:8080/auth/twitch/callback
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_AUTH_LOGIN=
TWITCH_AUTH_USER_ID=

DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=http://localhost:8080/auth/donationalerts/callback
DONATIONALERTS_ACCESS_TOKEN=
DONATIONALERTS_REFRESH_TOKEN=
DONATIONALERTS_AUTH_USER_ID=
DONATIONALERTS_AUTH_CODE=
DONATIONALERTS_AUTH_NAME=

OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

SESSION_STORE_PATH=data/session-store.sqlite3
LOCAL_CLIPS_DIR=assets/clips
CLIP_CACHE_DIR=assets/clip-cache
COLLECTOR_STREAM_POLL_SECONDS=45
COLLECTOR_CHATTERS_POLL_SECONDS=60
CLIPS_FALLBACK_DAYS=30
CLIPS_LIMIT=12
CLIPS_PREFETCH_SECONDS=180

# TWITCH_CHANNEL_LOGIN исключается из зрительских списков автоматически.
# Через запятую: ваши боты и служебные аккаунты, которых не нужно учитывать в серии просмотров.
# Известные сервисные боты вроде nightbot/streamelements тоже исключаются автоматически.
# Ники живых людей, даже если они заканчиваются на bot, останутся в серии.
# Пример: ENDING_BOT_LOGINS=mybot,mychatbot
ENDING_BOT_LOGINS=
