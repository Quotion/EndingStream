# Секреты и токены. Никогда не коммитить.
.env

# Окружения Python
venv/
venv_*/
.venv/
__pycache__/
*.pyc

# Локальные данные эфиров: ники зрителей, токены в логах, pid-файлы
data/

# Кэш скачанных Twitch-клипов (десятки гигабайт, чужой контент)
assets/clip-cache/

# Свои клипы-резервы не коммитим; встроенные заставки оставляем
assets/clips/*
!assets/clips/local-fallback-*.mp4

# Музыка: права на треки принадлежат не нам
assets/*.[mM][pP]3

# Служебное
test-results/
dist/
*.log
*.pid
*.status
